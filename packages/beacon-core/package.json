{
  "name": "@ttt-productions/beacon-core",
  "version": "0.0.2",
  "description": "Generic change beacon: the stamp, its writer, the pure change decision, and the observer",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ttt-productions/ttt-packages.git",
    "directory": "packages/beacon-core"
  },
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "default": "./dist/server/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "default": "./dist/react/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist *.tsbuildinfo",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run clean && npm run build"
  },
  "dependencies": {
    "@ttt-productions/firebase-helpers": "*",
    "zod": "^4.6.7"
  },
  "peerDependencies": {
    "@ttt-productions/query-core": "*",
    "react": ">=19.0.0"
  },
  "peerDependenciesMeta": {
    "@ttt-productions/query-core": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@tanstack/react-query": "^5.90.0",
    "@ttt-productions/query-core": "*",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "firebase": "^12.14.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "engines": {
    "node": ">=22",
    "npm": ">=10"
  },
  "author": "DJ (TTT Productions)",
  "license": "MIT"
}
