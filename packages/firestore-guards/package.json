{
    "name": "@ttt-productions/firestore-guards",
    "version": "0.1.0",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/ttt-productions/ttt-packages.git",
        "directory": "packages/firestore-guards"
    },
    "type": "module",
    "main": "dist/index.js",
    "module": "dist/index.js",
    "types": "dist/index.d.ts",
    "sideEffects": false,
    "files": [
        "dist"
    ],
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
        "./node": {
            "types": "./dist/node/index.d.ts",
            "default": "./dist/node/index.js"
        }
    },
    "scripts": {
        "build": "tsc",
        "clean": "rm -rf dist *.tsbuildinfo",
        "typecheck": "tsc --noEmit",
        "prepublishOnly": "npm run clean && npm run build"
    },
    "peerDependencies": {
        "typescript": ">=5.0.0"
    },
    "devDependencies": {
        "@types/node": "^24.13.6",
        "typescript": "^6.0.3",
        "zod": "^4.4.3"
    },
    "engines": {
        "node": ">=22",
        "npm": ">=10"
    },
    "author": "DJ (TTT Productions)",
    "license": "MIT"
}
