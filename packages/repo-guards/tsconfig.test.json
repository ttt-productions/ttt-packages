{
  // Type-checks the package's source and tests together under the root `tsc -b`. The package keeps
  // analyzers and fixtures authored in JavaScript; reading them for their types needs allowJs, which
  // stays confined to this package.
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "composite": true,
    "allowJs": true,
    "checkJs": false,
    "rootDir": "../..",
    "outDir": "node_modules/.cache/tsc-test",
    "tsBuildInfoFile": "node_modules/.cache/tsc-test/tsconfig.test.tsbuildinfo"
  },
  "include": ["src", "__tests__", "../../test/timeouts.ts"],
  "exclude": ["node_modules", "dist"]
}
