{
  // repo-guards is excluded: its own project alone reads JavaScript for its types.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.cache/tsc-workspace/tsconfig.workspace.tsbuildinfo"
  },
  "include": ["**/*"],
  "exclude": ["node_modules", "dist", "build", "packages/repo-guards"]
}
