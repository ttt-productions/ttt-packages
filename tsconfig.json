{
    "compilerOptions": {
      "target": "ES2022",
      "lib": ["ES2022", "DOM", "DOM.Iterable"],
      // TypeScript 6 auto-includes no @types package. Package builds and typechecks compile only
      // `src`, so they see Node globals (`process`, `node:*` modules) through this entry.
      "types": ["node"],
      "module": "ESNext",
      "moduleResolution": "bundler",
      "jsx": "react-jsx",
      "strict": true,
      "esModuleInterop": true,
      "skipLibCheck": true,
      "forceConsistentCasingInFileNames": true,
      "declaration": true,
      "declarationMap": true,
      "sourceMap": true,
      "inlineSources": true,
      "resolveJsonModule": true,
      "allowSyntheticDefaultImports": true,
      "noUnusedLocals": true,
      "noUnusedParameters": true,
      "noImplicitReturns": true,
      "noFallthroughCasesInSwitch": true,
      "noEmit": false
    },
    "exclude": ["node_modules", "dist", "build"],
    // `tsc -b` from here type-checks the two projects below and compiles nothing of its own; each
    // package's config extends this file for its compiler options and names its own files.
    "files": [],
    "references": [{ "path": "./tsconfig.workspace.json" }, { "path": "./packages/repo-guards/tsconfig.test.json" }]
  }
