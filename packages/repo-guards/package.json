{
    "name": "@ttt-productions/repo-guards",
    "version": "0.1.26",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/ttt-productions/ttt-packages.git",
        "directory": "packages/repo-guards"
    },
    "type": "module",
    "main": "dist/index.js",
    "module": "dist/index.js",
    "types": "dist/index.d.ts",
    "sideEffects": false,
    "files": [
        "dist"
    ],
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
        "./node": {
            "types": "./dist/node/index.d.ts",
            "default": "./dist/node/index.js"
        },
        "./node/suite": {
            "types": "./dist/node/suite/index.d.ts",
            "default": "./dist/node/suite/index.js"
        },
        "./node/reports": {
            "types": "./dist/node/reports/index.d.ts",
            "default": "./dist/node/reports/index.js"
        },
        "./node/tooling": {
            "types": "./dist/node/tooling/index.d.ts",
            "default": "./dist/node/tooling/index.js"
        },
        "./seed": {
            "types": "./dist/seed/index.d.ts",
            "default": "./dist/seed/index.js"
        },
        "./zod-shape": {
            "types": "./dist/zod-shape/index.d.ts",
            "default": "./dist/zod-shape/index.js"
        }
    },
    "scripts": {
        "build": "tsc",
        "clean": "rm -rf dist *.tsbuildinfo",
        "typecheck": "tsc --noEmit",
        "prepublishOnly": "npm run clean && npm run build"
    },
    "dependencies": {
        "semver": "^7.7.0",
        "yaml": "^2.9.1"
    },
    "peerDependencies": {
        "typescript": ">=5.0.0",
        "vitest": ">=4.0.0"
    },
    "peerDependenciesMeta": {
        "vitest": {
            "optional": true
        }
    },
    "devDependencies": {
        "@types/node": "^24.13.6",
        "@types/semver": "^7.7.0",
        "typescript": "^6.0.3",
        "vitest": "^4.1.12",
        "zod": "^4.6.7"
    },
    "engines": {
        "node": ">=22",
        "npm": ">=10"
    },
    "author": "DJ (TTT Productions)",
    "license": "MIT"
}
